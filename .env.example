# Client id of your app at https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Redirect URI registered on that same app. Spotify rejects localhost, so use the
# loopback address and open the app at http://127.0.0.1:3000 to match it.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=
# Playlist reader worker (worker/), lets visitors paste any public Spotify link
# with no sign in. Leave empty to fall back to Spotify sign in.
NEXT_PUBLIC_SPOTIFY_PROXY=
